# IBM Quantum Platform credentials
# 1. Create an account + instance at https://quantum.ibm.com/
# 2. Copy this file to `.env`  ->  cp .env.example .env
# 3. Fill in the values below (the real .env is git-ignored)

# Cloud Resource Name of your quantum-computing instance
CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/<account-id>:<instance-id>::

# API key from https://quantum.ibm.com/ -> Account settings
IBM_API_KEY=your-ibm-quantum-api-key-here
